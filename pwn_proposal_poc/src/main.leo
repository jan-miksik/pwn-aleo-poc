    fn withdraw_private_compliant(public id: field, terms: pwn_hub_poc.aleo::OfferTerms,
        opening: pwn_hub_poc.aleo::OfferOpening, maker_salt: field, public amount: u128)
        -> (dyn record, dyn record, Final) {
