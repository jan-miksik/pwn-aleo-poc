      "program": "import pwn_config_demo.aleo;\n\nprogram pwn_hub_demo.aleo;\n\nstruct ModuleTag:\n    module as address;\n    tag as u8;\n\nmapping approved:\n    key as field.public;\n    value as boolean.public;\n\nfunction set_tag:\n    input r0 as address.public;\n    input r1 as u8.public;\n    input r2 as boolean.public;\n    is.eq r1 1u8 into r3;\n    is.eq r1 2u8 into r4;\n    or r3 r4 into r5;\n    assert.eq r5 true;\n    cast r0 r1 into r6 as ModuleTag;\n    hash.bhp256 r6 into r7 as field;\n    async set_tag self.signer r7 r2 into r8;\n    output r8 as pwn_hub_demo.aleo/set_tag.future;\n\nfinalize set_tag:\n    input r0 as address.public;\n    input r1 as field.public;\n    input r2 as boolean.public;\n    get pwn_config_demo.aleo/settings[true] into r3;\n    assert.eq r3.admin r0;\n    set r2 into approved[r1];\n\nconstructor:\n    assert.eq edition 0u16;\n",
