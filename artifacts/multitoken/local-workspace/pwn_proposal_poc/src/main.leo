fn validate_aleo_asset::[VERSION: u16](asset: pwn_hub_poc.aleo::Asset) {
    assert_eq(asset.family, 1u8);
    assert_eq(asset.version, VERSION);
    assert_eq(asset.token_id, 0field);
    assert_eq(asset.program_id, 'credits');
